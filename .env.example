# ─────────────────────────────────────────────────────────────
#  FIREBASE AYARLARI
# ─────────────────────────────────────────────────────────────
# Bu dosyayı ".env" olarak kopyalayıp Firebase bilgilerinizi girin.
# Firebase Console > Proje Ayarları > "Web uygulaması" bölümünden alın.
#
# Bu değerler GİRİLMEZSE canlı build DURUR. Yerel deneme için açıkça
# npm run build -- --mode demo kullanılır (çıktı: dist-demo, YAYIMLAMAYIN).
# Gerçek cihazlar arası senkron için aşağıyı doldurun.
# ─────────────────────────────────────────────────────────────

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
